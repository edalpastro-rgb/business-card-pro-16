# .env.example — Axon Core su VPS · copia in `.env` accanto a docker-compose.yml e compila.
# Regola: MAI committare il .env reale. I valori attuali di produzione si prendono dal pannello Emergent del job Core
# (backend/.env) e si incollano qui. Le chiavi non usate possono restare vuote.

# ───────────── Core / runtime ─────────────
APP_ENV=production
PORT=8001
# URL pubblico di Core dietro nginx (usato per link firmati, callback OAuth, deep link nelle email)
APP_PUBLIC_URL=https://80.211.27.80
# URL pubblico dell'app AdvisorOS (deep link nelle notifiche/email)
EXPO_PUBLIC_APP_URL=https://app.advisoros.it

# ───────────── MongoDB (servizio `mongodb` del compose, volume persistente) ─────────────
MONGO_ROOT_USER=axon
MONGO_ROOT_PASSWORD=CAMBIAMI_password_lunga_e_casuale
DB_NAME=axon_core
# MONGO_URL viene composto automaticamente da docker-compose. Se usi un Mongo esterno (Atlas) sblocca e imposta:
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/axon_core

# ───────────── Sicurezza / cifratura (stesso valore dell'ambiente attuale → i token e i dati cifrati restano validi) ─────────────
JWT_SECRET=CAMBIAMI_stesso_valore_di_produzione
FIELD_ENC_KEY=
SENSITIVE_ENC_KEY=
OUTLOOK_TOKEN_ENC_KEY=
GOOGLE_DRIVE_TOKEN_KEY=
TOTP_ISSUER=AdvisorOS

# ───────────── Ruoli ─────────────
SUPER_MASTER_EMAILS=emanuele@example.it
ADVISOR_SUPER_ADMIN_EMAILS=

# ───────────── AI: LLM (Claude/GPT/Gemini), Whisper STT, OpenAI TTS, Object Storage — tutto via Emergent LLM Key ─────────────
EMERGENT_LLM_KEY=sk-emergent-CAMBIAMI
# Proxy integrazioni Emergent (Object Storage, push, whisper). Lascia il default se non diversamente indicato.
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
# Whisper: usa la Emergent LLM Key (OpenAI whisper-1). Nessuna chiave separata necessaria.
# TTS locale Kokoro: 1 = disattivato (voce OpenAI TTS, consigliato su VPS 2 vCPU) · 0 = attivo (scarica ~340 MB al primo uso)
KOKORO_DISABLE=1
# Ricerca web
TAVILY_API_KEY=

# ───────────── Voice Pass (wake-word / verifica voce) ─────────────
VP_MIN_SPEECH_SEC=
VP_MIN_CONSISTENCY=

# ───────────── Auth Emergent (Google login) ─────────────
EMERGENT_AUTH_BASE_URL=https://auth.emergentagent.com

# ───────────── Push notifications (Emergent managed) ─────────────
EMERGENT_PUSH_KEY=

# ───────────── Email (Emergent managed Resend) ─────────────
EMERGENT_EMAIL_KEY=
RESEND_API_KEY=
EMAIL_FROM_NAME=AdvisorOS
EMAIL_REPLY_TO=
SENDER_INFO=
SENDER_HELP=
SENDER_EMANUELE=
MASTER_NOTIFY_EMAIL=
BILLING_SUPPORT_EMAIL=

# ───────────── Google (Drive / Calendar / Gmail) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_DRIVE_REDIRECT_URI=https://80.211.27.80/api/drive/callback
GOOGLE_DRIVE_FRONTEND_URL=https://app.advisoros.it

# ───────────── Microsoft / Outlook ─────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=https://80.211.27.80/api/outlook/callback
MS_SCOPES=
OUTLOOK_APP_RETURN_URL=https://app.advisoros.it

# ───────────── Dropbox ─────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://80.211.27.80/api/dropbox/callback

# ───────────── Stripe ─────────────
STRIPE_API_KEY=

# ───────────── Demo / seed ─────────────
DEMO_SEED_DISABLED=1
DEMO_SEED_EMAIL=
DEMO_SEED_PASSWORD=
DEMO_LEAD_OWNER_EMAIL=

# ───────────── CORS ─────────────
# Core accetta oggi tutte le origini (allow_origins=["*"] in routes/37_app_startup_scheduler.py) → AdvisorOS web,
# Axon Lite web e le app native funzionano senza configurazione. Se in futuro si vuole restringere, elencare qui
# le origini consentite (informativo, non ancora letto dal codice — regola: non modificare Core in questa fase):
CORS_ORIGINS=https://app.advisoros.it,https://lite.advisoros.it,https://business-card-pro-16.preview.emergentagent.com
