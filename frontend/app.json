{
  "expo": {
    "name": "AdvisorOS",
    "slug": "AdvisorOS",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.consulenteapp.zkleir",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sblocca rapidamente Dal Pastro CRM",
        "NSPhotoLibraryUsageDescription": "Aggiungi immagini motivazionali al tuo spazio personale",
        "NSCameraUsageDescription": "Scatta foto e scansiona bollette e QR",
        "NSMicrophoneUsageDescription": "Parla con AxonOS e registra note vocali",
        "UIBackgroundModes": [
          "audio"
        ],
        "NSContactsUsageDescription": "Importa i contatti dalla tua rubrica",
        "NSLocationWhenInUseUsageDescription": "Meteo, mappa clienti e percorsi dalla tua posizione"
      }
    },
    "android": {
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.emergent.consulenteapp.zkleir",
      "versionCode": 16,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F2438"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Parla con AxonOS e registra note vocali",
          "enableBackgroundRecording": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Scatta foto e scansiona bollette e QR",
          "android": {
            "permissions": [
              "CAMERA"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aggiungi immagini ai tuoi contatti e bollette",
          "cameraPermission": "Scatta foto per aggiungerle ai contatti"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sblocca rapidamente Dal Pastro CRM"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#EA580C"
        }
      ],
      "expo-asset",
      "onnxruntime-react-native",
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      "./plugins/withCameraPermission.js",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Scansiona documenti con ritaglio automatico"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
