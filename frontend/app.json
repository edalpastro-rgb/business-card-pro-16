{
  "expo": {
    "name": "AdvisorOS",
    "slug": "AdvisorOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.consulenteapp.zkleir",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Sblocca rapidamente Dal Pastro CRM",
        "NSPhotoLibraryUsageDescription": "Aggiungi immagini motivazionali al tuo spazio personale",
        "NSCameraUsageDescription": "Scatta foto e scansiona bollette e QR",
        "NSMicrophoneUsageDescription": "Registra note vocali sui tuoi contatti",
        "NSContactsUsageDescription": "Importa i contatti dalla tua rubrica"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.consulenteapp.zkleir",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO",
        "READ_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F2438"
        }
      ],
      "expo-audio",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Scatta foto e scansiona bollette e QR"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aggiungi immagini ai tuoi contatti e bollette",
          "cameraPermission": "Scatta foto per aggiungerle ai contatti"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sblocca rapidamente Dal Pastro CRM"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#EA580C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
